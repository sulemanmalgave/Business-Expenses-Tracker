# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (e.g., https://your-app.run.app)
APP_URL="MY_APP_URL"

# ==============================================================
# MINIMAL PAYMENT GATEWAY CREDENTIALS (4 CREDENTIALS ONLY)
# Automatic plan creation via API. Zero webhooks required.
# ==============================================================

# Internal cryptographic secret for session integrity verification
SERVER_INTEGRITY_SECRET="your-secure-internal-secret-min-32-chars"

# --- 1. INDIA: RAZORPAY (INR ₹) ---
# Supports ₹199/month and ₹1,999/year.
# Plans are automatically retrieved or created via Razorpay API.
# Obtain from: https://dashboard.razorpay.com/#/accesskeys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"

# --- 2. OUTSIDE INDIA: PAYPAL (USD $) ---
# Supports $2.99/month and $29.99/year.
# Products and plans are automatically retrieved or created via PayPal API.
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="YourPayPalClientIdHere"
PAYPAL_CLIENT_SECRET="YourPayPalClientSecretHere"
